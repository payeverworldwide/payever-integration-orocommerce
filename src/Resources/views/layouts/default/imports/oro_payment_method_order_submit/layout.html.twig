{% block _order_review_payment_methods_payever_widget -%}
    {% if options.payment_method is defined %}
        {% set params = {
            paymentUrl: path('payever_payment_create', {id: app.request.attributes.get('id')}),
            paymentMethod: options.payment_method
        } %}

        <div class="hidden"
             data-page-component-module="payeverpayment-payever-payment-component"
             data-page-component-options="{{ params|json_encode }}">
        </div>
    {% endif %}
{% endblock %}
